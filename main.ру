from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.core.window import Window
from kivy.graphics import Color, RoundedRectangle
from kivy.uix.screenmanager import ScreenManager, Screen, SlideTransition
from kivy.metrics import dp

# 1. СТИЛЬНОЕ И БЕЗОПАСНОЕ ПОЛЕ ВВОДА
class ModernInput(TextInput):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.background_normal = ''
        self.background_active = ''
        self.background_color = (0.1, 0.1, 0.1, 1)    
        self.foreground_color = (1, 1, 1, 1)          
        self.hint_text_color = (0.35, 0.35, 0.35, 1)  
        self.halign = 'center'
        self.multiline = False
        self.font_size = dp(18)
        self.padding_x = dp(10)
        self.padding_y = dp(16)

# 2. КРУПНАЯ СИНЯЯ КНОПКА ВО ВЕСЬ ЭКРАН
class ModernButton(Button):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.background_normal = ''
        self.background_color = (0, 0, 0, 0)
        self.bold = True
        self.font_size = dp(16)
        self.color = (1, 1, 1, 1) 
        self.bind(pos=self.update_canvas, size=self.update_canvas)
        
    def update_canvas(self, *args):
        self.canvas.before.clear()
        with self.canvas.before:
            Color(0.0, 0.47, 0.84, 1) 
            RoundedRectangle(pos=self.pos, size=self.size, radius=[dp(4)])

# 3. ПЛАШКА ДЛЯ СТАТИСТИКИ
class FaceitWidget(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.bind(pos=self.update_canvas, size=self.update_canvas)
        
    def update_canvas(self, *args):
        self.canvas.before.clear()
        with self.canvas.before:
            Color(0.12, 0.12, 0.12, 1) 
            RoundedRectangle(pos=self.pos, size=self.size, radius=[dp(12)])

# ЭКРАН ВХОДА
class LoginScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=dp(25), spacing=dp(14))
        
        layout.add_widget(Label(size_hint_y=None, height=dp(50)))
        title = Label(text="Wintrix\nFaceit", font_size=dp(48), bold=True, halign='center', valign='middle', size_hint_y=None, height=dp(140))
        title.bind(size=lambda el, sz: setattr(el, 'text_size', sz))
        layout.add_widget(title)
        
        layout.add_widget(Label(size_hint_y=None, height=dp(40)))
        self.id_input = ModernInput(hint_text="Введите ваш игровой ID", size_hint_y=None, height=dp(60))
        layout.add_widget(self.id_input)
        self.nick_input = ModernInput(hint_text="Введите ваш никнейм", size_hint_y=None, height=dp(60))
        layout.add_widget(self.nick_input)
        
        layout.add_widget(Label(size_hint_y=None, height=dp(25)))
        confirm_btn = ModernButton(text="ПОДТВЕРДИТЬ", size_hint_y=None, height=dp(60))
        confirm_btn.bind(on_press=self.confirm_and_go)
        layout.add_widget(confirm_btn)
        
        self.error_label = Label(text="", color=(1, 0.3, 0.3, 1), size_hint_y=None, height=dp(40), font_size=dp(14))
        layout.add_widget(self.error_label)
        layout.add_widget(Label())
        self.add_widget(layout)

    def confirm_and_go(self, instance):
        user_id = self.id_input.text.strip()
        nickname = self.nick_input.text.strip()
        
        if not user_id or not nickname:
            self.error_label.text = "Заполните все поля!"
            return
            
        self.error_label.text = ""
        self.manager.get_screen('stats').update_stats(nickname)
        self.manager.transition = SlideTransition(direction='left')
        self.manager.current = 'stats'

# ЭКРАН СТАТИСТИКИ
class StatsScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=dp(25), spacing=dp(20))
        layout.add_widget(Label(size_hint_y=None, height=dp(20)))
        
        self.welcome_label = Label(text="Игрок", font_size=dp(30), bold=True, halign='center', size_hint_y=None, height=dp(50))
        layout.add_widget(self.welcome_label)
        
        layout.add_widget(Label(text="Профиль успешно загружен", halign='center', font_size=dp(15), color=(0.3, 1, 0.3, 1), size_hint_y=None, height=dp(30)))
        
        widget_stats = FaceitWidget(orientation='vertical', padding=dp(20), spacing=dp(12), size_hint_y=None, height=dp(160))
        self.lvl_label = Label(text="FACEIT LEVEL:  6 LVL", font_size=dp(20), bold=True, color=(1, 0.35, 0.0, 1), halign='center')
        self.elo_label = Label(text="CURRENT ELO:  1540 ELO", font_size=dp(18), bold=True, halign='center')
        self.winrate_label = Label(text="WINRATE:  54%", font_size=dp(16), color=(0.7, 0.7, 0.7, 1), halign='center')
        
        widget_stats.add_widget(self.lvl_label)
        widget_stats.add_widget(self.elo_label)
        widget_stats.add_widget(self.winrate_label)
        layout.add_widget(widget_stats)
        
        layout.add_widget(Label())
        back_btn = ModernButton(text="ВЫЙТИ ИЗ АККАУНТА", size_hint_y=None, height=dp(60))
        back_btn.bind(on_press=self.go_back)
        layout.add_widget(back_btn)
        self.add_widget(layout)

    def update_stats(self, nickname):
        self.welcome_label.text = f"Игрок: {nickname}"

    def go_back(self, instance):
        self.manager.get_screen('login').id_input.text = ""
        self.manager.get_screen('login').nick_input.text = ""
        self.manager.transition = SlideTransition(direction='right')
        self.manager.current = 'login'

class WintrixFaceitApp(App):
    def build(self):
        Window.clearcolor = (0.06, 0.06, 0.06, 1)
        sm = ScreenManager()
        sm.add_widget(LoginScreen(name='login'))
        sm.add_widget(StatsScreen(name='stats'))
        return sm

if __name__ == "__main__":
    WintrixFaceitApp().run()

